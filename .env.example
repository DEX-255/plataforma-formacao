# Copie para .env.local e preencha. O .env.local nunca é versionado.

# ── Supabase ────────────────────────────────────────────────────────────────
# Estas duas podem chegar ao navegador. A anônima só faz o que a RLS permite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── D-07 — esta NUNCA chega ao navegador ────────────────────────────────────
# Ignora toda a RLS. É usada só pelo gerador do documento final, rodando local.
# Sem prefixo NEXT_PUBLIC_ de propósito: o prefixo é o que faria o Next embutir
# a chave no pacote enviado ao cliente. Se algum dia ela aparecer com prefixo,
# nota e observação interna de todos os participantes ficam expostas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Somente desenvolvimento ─────────────────────────────────────────────────
# NEXT_PUBLIC_LOGIN_LOCAL liga a entrada por senha na tela de login, para poder
# abrir as telas sem o OAuth do Google configurado. NUNCA defina em produção.
# Ela é deixada comentada aqui de propósito: quem copiar este arquivo não deve
# herdar a porta aberta.
